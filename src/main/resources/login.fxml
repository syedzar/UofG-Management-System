<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.manage.uofgmanagement.LoginController">

    <top>
        <Pane prefHeight="60" style="-fx-background-color: #0056b3;">
            <Label text="University Management System" layoutX="20" layoutY="15"
                   style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;" />
        </Pane>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15">
            <GridPane alignment="CENTER" hgap="10" vgap="10">
                <Label text="Email:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <TextField fx:id="emailField" />
                <Label text="Password:" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <PasswordField fx:id="passwordField" />
            </GridPane>
            <Button text="Login" fx:id="loginButton" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-size: 14px;"/>
            <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>
        </VBox>
    </center>

    <bottom>
        <Pane prefHeight="120">
            <ImageView fx:id="universityLogo" fitHeight="100" fitWidth="100" layoutX="10" layoutY="10"/>
        </Pane>
    </bottom>
</BorderPane>