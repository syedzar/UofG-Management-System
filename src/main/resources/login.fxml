<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.manage.uofgmanagement.LoginController"
      spacing="20" alignment="center" style="-fx-background-color: #f4f4f4;">

    <HBox style="-fx-background-color: #003366; -fx-padding: 15px;" alignment="center">
        <Label text="University Management System" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
    </HBox>

    <GridPane fx:id="loginPane" hgap="10" vgap="10" alignment="center">
        <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="usernameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Button fx:id="loginButton" text="Login" GridPane.rowIndex="2" GridPane.columnIndex="1"
                onAction="#handleLogin"/>

        <Label fx:id="errorLabel" text="" GridPane.rowIndex="3" GridPane.columnIndex="1"
               style="-fx-text-fill: red;"/>
    </GridPane>

    <HBox alignment="bottom_left">
        <ImageView fx:id="universityLogo" fitWidth="100" fitHeight="100"
                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </HBox>

</VBox>