<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="center" spacing="20" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.manage.uofgmanagement.AdminDashboardController">

    <!-- Header -->
    <HBox alignment="center" style="-fx-background-color: #003366; -fx-padding: 15px;">
        <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Admin Dashboard" />
    </HBox>

    <!-- Summary Metrics -->
    <HBox alignment="center" spacing="20" style="-fx-padding: 10px;">
        <VBox alignment="center" spacing="5">
            <Label style="-fx-font-size: 14px;" text="Total Students:" />
            <Label fx:id="totalStudentsLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="123" />
        </VBox>
        <VBox alignment="center" spacing="5">
            <Label style="-fx-font-size: 14px;" text="Total Courses:" />
            <Label fx:id="totalCoursesLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="45" />
        </VBox>
        <VBox alignment="center" spacing="5">
            <Label style="-fx-font-size: 14px;" text="Total Faculties:" />
            <Label fx:id="totalFacultiesLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="20" />
        </VBox>
        <VBox alignment="center" spacing="5">
            <Label style="-fx-font-size: 14px;" text="Upcoming Events:" />
            <Label fx:id="upcomingEventsLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="3" />
        </VBox>
    </HBox>

    <!-- Admin Actions -->
    <GridPane alignment="center" hgap="20" style="-fx-padding: 10px;" vgap="20">
        <!-- Define column constraints for alignment -->
        <columnConstraints>
            <!-- First column for labels -->
            <ColumnConstraints halignment="RIGHT" minWidth="150" />
            <!-- Second column for buttons, which will grow as needed -->
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" />
        </columnConstraints>

        <!-- Student Management -->
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Student Management:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <HBox alignment="center" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Button fx:id="addStudentButton" onAction="#handleAddStudentAction" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Student Management" />
        </HBox>

        <!-- Subject Management -->
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Subject Management:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <HBox alignment="center" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Button fx:id="addSubjectButton" onAction="#handleAddSubject" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Add Subject" />
            <Button fx:id="editSubjectButton" onAction="#handleEditSubject" style="-fx-background-color: #FFC107; -fx-text-fill: white;" text="Edit Subject" />
            <Button fx:id="deleteSubjectButton" onAction="#handleDeleteSubject" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="Delete Subject" />
        </HBox>

        <!-- Course Management -->
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Course Management:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <HBox alignment="center" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <!-- View Courses button -->
            <Button fx:id="viewCoursesButton" onAction="#handleViewCoursesAction" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="View Courses" />
        </HBox>

        <!-- Faculty Management -->
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Faculty Management:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <HBox alignment="center" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <Button fx:id="addFacultyButton" onAction="#handleAddFacultyAction" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Add Faculty" />
        </HBox>

        <!-- Event Management -->
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Event Management:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <HBox alignment="center" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4">
            <Button fx:id="addEventButton" onAction="#handleAddEvent" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Add Event" />
            <Button fx:id="editEventButton" onAction="#handleEditEvent" style="-fx-background-color: #FFC107; -fx-text-fill: white;" text="Edit Event" />
            <Button fx:id="deleteEventButton" onAction="#handleDeleteEvent" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="Delete Event" />
        </HBox>

        <!-- Define row constraints -->
        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>
    </GridPane>
   <Button mnemonicParsing="false" onAction="#handleLogout" text="Logout" />

    <!-- Footer -->
    <HBox alignment="center" spacing="10" style="-fx-padding: 10px;">
        <Label style="-fx-font-size: 12px;" text="© 2025 University Management System" />
    </HBox>

</VBox>
