<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="center" spacing="20" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.manage.uofgmanagement.UserDashboardController">

    <!-- Header -->
    <HBox alignment="center" style="-fx-background-color: #003366; -fx-padding: 15px;">
        <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="User Dashboard" />
    </HBox>

    <!-- Welcome Section -->
    <HBox alignment="center" spacing="10" style="-fx-padding: 10px;">
        <Label style="-fx-font-size: 16px;" text="Welcome, " />
        <Label fx:id="usernameLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="John Doe" />
    </HBox>

    <!-- Summary Metrics -->
    <HBox alignment="center" spacing="20" style="-fx-padding: 10px;">
        <VBox alignment="center" spacing="5">
            <Label style="-fx-font-size: 14px;" text="Enrolled Courses:" />
            <Label fx:id="enrolledCoursesLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="-" />
        </VBox>
        <VBox alignment="center" spacing="5">
            <Label style="-fx-font-size: 14px;" text="Completed Courses:" />
            <Label fx:id="completedCoursesLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="-" />
        </VBox>
        <VBox alignment="center" spacing="5">
            <Label style="-fx-font-size: 14px;" text="Pending Assignments:" />
            <Label fx:id="pendingAssignmentsLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="-" />
        </VBox>
        <VBox alignment="center" spacing="5">
            <Label style="-fx-font-size: 14px;" text="Notifications:" />
            <Label fx:id="notificationsLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="-" />
        </VBox>
    </HBox>

    <!-- User Actions -->
    <GridPane alignment="center" hgap="20" style="-fx-padding: 10px;" vgap="20">
        <!-- Define column constraints for alignment -->
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="150" />
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" />
        </columnConstraints>

        <!-- Profile Management -->
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Profile Management:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <HBox alignment="center" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Button fx:id="viewProfileButton" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="View Profile" />
            <Button fx:id="editProfileButton" style="-fx-background-color: #FFC107; -fx-text-fill: white;" text="Edit Profile" />
        </HBox>

        <!-- Subject Management -->
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Subject Management:" GridPane.rowIndex="1" />
        <HBox alignment="center" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Button fx:id="viewSubjectsButton" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="View Subjects" />
        </HBox>

        <!-- Course Management (Added Enroll Button) -->
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Course Management:" GridPane.rowIndex="2" />
        <HBox alignment="center" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Button fx:id="viewCoursesButton" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="View Courses" />
        </HBox>

        <!-- Assignments -->
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Assignments:" GridPane.rowIndex="3" />
        <HBox alignment="center" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <Button fx:id="viewAssignmentsButton" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="View Assignments" />
            <Button fx:id="submitAssignmentButton" style="-fx-background-color: #FFC107; -fx-text-fill: white;" text="Submit Assignment" />
        </HBox>

        <!-- Notifications -->
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Notifications:" GridPane.rowIndex="4" />
        <HBox alignment="center" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4">
            <Button fx:id="viewNotificationsButton" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="View Notifications" />
        </HBox>

        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>
    </GridPane>
    <Button fx:id="logoutButton2" text="Logout" onAction="#handleLogout2"/>


    <!-- Footer -->
    <HBox alignment="center" spacing="10" style="-fx-padding: 10px;">
        <Label style="-fx-font-size: 12px;" text="© 2025 University Management System" />
    </HBox>
</VBox>
