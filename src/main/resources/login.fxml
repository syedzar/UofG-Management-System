<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.manage.uofgmanagement.LoginController"
            prefWidth="400" prefHeight="300" style="-fx-background-color: #f4f4f4;">

    <Label text="University Management System" layoutX="50" layoutY="20"
           style="-fx-font-size: 18px; -fx-text-fill: #1E3A8A; -fx-font-weight: bold;"/>

    <Label text="Email:" layoutX="50" layoutY="70"/>
    <TextField fx:id="emailField" layoutX="120" layoutY="65" prefWidth="200"/>

    <Label text="Password:" layoutX="50" layoutY="120"/>
    <PasswordField fx:id="passwordField" layoutX="120" layoutY="115" prefWidth="200"/>

    <Button text="Login" layoutX="150" layoutY="170" fx:id="loginButton"/>

    <ImageView fx:id="universityLogo" fitWidth="80" fitHeight="80"
               layoutX="300" layoutY="200" preserveRatio="true"/>
</AnchorPane>
